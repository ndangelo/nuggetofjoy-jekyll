---
layout: null
permalink: /admin/index-data.json
---
{
  "title": {{ site.title | jsonify }},
  "posts": [
    {% for item in site.posts limit: 1000 %}
    {
      "title": {{ item.title | default: "Untitled" | jsonify }},
      "date": {{ item.date | date_to_xmlschema | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "description": {{ item.description | default: item.excerpt | strip_html | normalize_whitespace | truncate: 180 | jsonify }},
      "categories": {{ item.categories | join: ", " | jsonify }},
      "editorPath": {{ item.path | split: "/" | last | remove: ".md" | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ],
  "pages": [
    {% assign cms_pages = site.collections.pages.docs %}
    {% for item in cms_pages %}
    {
      "title": {{ item.title | default: item.name | default: "Untitled page" | jsonify }},
      "date": {{ item.date | default: item.last_modified_at | default: site.time | date_to_xmlschema | jsonify }},
      "url": {{ item.url | relative_url | jsonify }},
      "description": {{ item.description | default: "" | strip_html | normalize_whitespace | truncate: 180 | jsonify }},
      "categories": "Page",
      "editorPath": {{ item.path | split: "/" | last | remove: ".md" | jsonify }}
    }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
